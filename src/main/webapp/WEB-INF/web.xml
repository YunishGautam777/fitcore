<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!-- Servlet Mappings -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddMemberServlet</servlet-name>
        <servlet-class>controller.AddMemberServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddMemberServlet</servlet-name>
        <url-pattern>/AddMemberServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ViewMembersServlet</servlet-name>
        <servlet-class>controller.ViewMembersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewMembersServlet</servlet-name>
        <url-pattern>/ViewMembersServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteMemberServlet</servlet-name>
        <servlet-class>controller.DeleteMemberServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteMemberServlet</servlet-name>
        <url-pattern>/DeleteMemberServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UpdateMemberServlet</servlet-name>
        <servlet-class>controller.UpdateMemberServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateMemberServlet</servlet-name>
        <url-pattern>/UpdateMemberServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SearchMemberServlet</servlet-name>
        <servlet-class>controller.SearchMemberServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SearchMemberServlet</servlet-name>
        <url-pattern>/SearchMemberServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddTrainerServlet</servlet-name>
        <servlet-class>controller.AddTrainerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddTrainerServlet</servlet-name>
        <url-pattern>/AddTrainerServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ViewTrainersServlet</servlet-name>
        <servlet-class>controller.ViewTrainersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewTrainersServlet</servlet-name>
        <url-pattern>/ViewTrainersServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteTrainerServlet</servlet-name>
        <servlet-class>controller.DeleteTrainerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteTrainerServlet</servlet-name>
        <url-pattern>/DeleteTrainerServlet</url-pattern>
    </servlet-mapping>

    <!-- Welcome file -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

</web-app>